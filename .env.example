# ── Nebius Token Factory (https://studio.nebius.com) ──────────────────────────
NEBIUS_API_KEY=your_nebius_key
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

# Simultaneous Nebius requests. Too high and Nebius throttles by returning
# empty completions rather than a 429. Raise only if your account has headroom.
NEBIUS_CONCURRENCY=2

# Model IDs. These are the two the project benchmarked and selected:
#   ULTRA — verification, counter-readings and briefing synthesis
#   SUPER — per-source extraction inside the collectors
# Verify the exact strings your account serves with:  npm run models
# (or GET /api/models once the server is up).
NEBIUS_MODEL_ULTRA=nvidia/Nemotron-3-Ultra-550b-a55b
NEBIUS_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b

# ── Tavily web search (https://tavily.com) ────────────────────────────────────
TAVILY_API_KEY=your_tavily_key

# advanced = 2 credits per search (default, best quality)
# basic    = 1 credit per search — use while iterating on queries
TAVILY_DEPTH=advanced

# ── Which business this deployment serves ─────────────────────────────────────
# The profile holds the roster, the queries, the signal polarity and the scoring
# guidance. See server/profiles/README.md before writing a new one.
PROFILE=exec-search

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
CRON_SCHEDULE=0 7 * * 1
CRON_ENABLED=true

# Set true to run the pipeline with fixture data and zero API calls.
DRY_RUN=false
