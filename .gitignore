node_modules/
.env
# Collected data is per profile now — data/<profile>/*.json. The old pattern
# only matched the top level, so the moment the register moved into a
# subdirectory it would have been committed to a public repo.
data/**/*.json
data/.pipeline.lock
!data/.gitkeep
npm-debug.log*
.DS_Store

# Pre-cleanup register snapshots. These contain the junk entries the register
# guards now reject ("United Kingdom" scored 90 Critical, and similar). They are
# useful locally as before/after evidence and must never be public: a reader
# finds them and reasonably assumes they are the current output.
data/**/*.backup
*.backup

# Internal handoff notes and render artefacts. These documented problems
# with the submission video and timings; a judge browsing the repo should not
# be reading our own notes on what was wrong with it. Kept locally.
*-HANDOFF.md
auspius-demo.mp4
*.mp4

# The Devpost entry text itself. It is filled in on Devpost; a judge
# reading the draft in the repo gains nothing and sees scaffolding.
DEVPOST-SUBMISSION.md
